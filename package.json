{
  "name": "git-smart-commits",
  "version": "0.1.0",
  "description": "CLI that uses an LLM to generate Conventional Commit messages and commit your git changes (squash or split).",
  "type": "module",
  "license": "MIT",
  "author": "dazuaz",
  "repository": {
    "type": "git",
    "url": "https://github.com/dazuaz/git-smart-commits.git"
  },
  "bugs": {
    "url": "https://github.com/dazuaz/git-smart-commits/issues"
  },
  "homepage": "https://github.com/dazuaz/git-smart-commits#readme",
  "keywords": [
    "git",
    "cli",
    "commit",
    "conventional-commits",
    "llm",
    "openai",
    "bun"
  ],
  "files": [
    "src",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "git-smart-commit": "bin/git-smart-commit"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "build": "bun build ./src/cli.ts --compile --outfile ./bin/git-smart-commit",
    "check": "bun test && bun run build",
    "prepare": "bun run build"
  }
}
